# Week 8 Prompt Engineering Lab: environment settings
#
# 1. Copy this file to .env in the same folder as the notebook:
#        cp env.sample .env
# 2. Set LLM_PROVIDER and uncomment the lines for that ONE provider.
# 3. Restart the Jupyter kernel and run the setup cell (Part 0).
#
# .env is listed in .gitignore. Never commit it, and never paste keys into the notebook.
#
# Leave optional lines commented out to use the default shown. A line with an
# empty value (e.g. OPENAI_MODEL=) replaces the default with an empty string.
# Variables already set in your shell take precedence over this file.

# Which provider to use: openai | azure | watsonx | mock
# mock runs offline and returns placeholder text (no key needed).
LLM_PROVIDER=mock


# ---------------------------------------------------------------- OpenAI
# LLM_PROVIDER=openai          pip install openai
# Key: https://platform.openai.com/api-keys

# OPENAI_API_KEY=sk-...

# Optional (defaults shown)
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small


# ---------------------------------------------------------------- Azure OpenAI
# LLM_PROVIDER=azure           pip install openai
# Key and endpoint: Azure portal > your Azure OpenAI resource > Keys and Endpoint.
# Use your DEPLOYMENT names (as created in Azure AI Foundry), not model names.

# AZURE_OPENAI_API_KEY=your-azure-openai-key
# AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
#   (a URL ending in /openai/v1, as the portal may show it, also works: the notebook trims it)
# AZURE_OPENAI_DEPLOYMENT=your-chat-deployment-name

# Optional. Without an embedding deployment, Part 8 and the capstone use TF-IDF.
# AZURE_OPENAI_EMBED_DEPLOYMENT=your-embedding-deployment-name
# AZURE_OPENAI_API_VERSION=2024-10-21


# ---------------------------------------------------------------- IBM watsonx.ai
# LLM_PROVIDER=watsonx         pip install ibm-watsonx-ai
# API key: IBM Cloud > Manage > Access (IAM) > API keys
# Project ID: watsonx.ai project > Manage tab > General > Project ID
# URL: the endpoint for your region, e.g.
#   https://us-south.ml.cloud.ibm.com   (Dallas)
#   https://eu-de.ml.cloud.ibm.com      (Frankfurt)
#   https://eu-gb.ml.cloud.ibm.com      (London)
#   https://jp-tok.ml.cloud.ibm.com     (Tokyo)

# WATSONX_APIKEY=your-ibm-cloud-api-key
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_PROJECT_ID=your-project-id

# Optional (defaults shown)
# WATSONX_MODEL=ibm/granite-3-3-8b-instruct
# WATSONX_EMBED_MODEL=ibm/slate-125m-english-rtrvr
